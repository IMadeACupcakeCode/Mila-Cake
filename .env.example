# Mila Bot - Configuracao
# Copie para .env e preencha com os valores do Discord Developer Portal.
# NUNCA faça commit do .env real: ele contém segredos.

# Token do bot (mantenha em segredo; rotacione se vazar)
DISCORD_TOKEN=your-discord-token-here

# ID da aplicação (bot) - discord.com/developers/applications
CLIENT_ID=your-client-id-here

# ID do servidor opcional: registra comandos também no servidor para testes
GUILD_ID=your-guild-id-here

# Ativa intents privilegiadas (GuildMembers, GuildPresences).
# Mantenha false a menos que o bot realmente precise de membros/presenças.
ENABLE_PRIVILEGED_INTENTS=false

# Personalização (opcional - usa padrões quando vazio)
BOT_NOME=Mila Bot
COMANDO_SOBRE_NOME=sobre
COMANDO_SOBRE_ALIAS=mila,milabot,botinfo
CONTEXTO_SERVIDOR=Mila Cake

# ── Identidade do criador dentro do bot ─────────────────────────────────────
# O username vem preenchido para o projeto original. Para uma instalação sua,
# substitua pelo seu username global ou configure um ID estável em CRIADOR_IDS.
# O ID descoberto é salvo localmente em data/criador.json.
CRIADOR_USERNAME=acupcakecatsocial
# Nomes alternativos, se necessário (separados por vírgula).
CRIADOR_USERNAMES=
# IDs fixos (recomendado; separados por vírgula).
CRIADOR_IDS=

# MilaTube Activity (opcional; sem isso /assistir explica o que falta)
# A Activity precisa estar habilitada na MESMA aplicação do bot (CLIENT_ID).
# ACTIVITY_API_URL: origem pública do Worker, sem /api no final.
# ACTIVITY_API_SECRET: o mesmo valor de BOT_API_SECRET no Worker.
# ACTIVITY_APPLICATION_ID: opcional; usa CLIENT_ID quando vazio.
ACTIVITY_API_URL=
ACTIVITY_API_SECRET=
ACTIVITY_APPLICATION_ID=

# Spotify (opcional; necessário para resolver buscas/links Spotify).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=BR
SPOTIFY_AUTH_PORT=8888
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Banco de dados opcional; vazio usa data/mila.db.
MILA_DATABASE_PATH=

# ── Música (yt-dlp) ───────────────────────────────────────────────────────────
# O binário do yt-dlp é obtido automaticamente na primeira execução: reaproveita
# o que o npm baixou ou baixa do GitHub para data/bin. Não há passo manual.

# Opcional (VPS/container sem navegador): cookies em base64.
# Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# Linux/macOS: base64 -w0 cookies.txt
YTDLP_COOKIES_BASE64=
# Alternativa: conteúdo do cookies.txt com quebras de linha escapadas como \n
YTDLP_COOKIES=
# Alternativa: caminho de um cookies.txt já existente no servidor
YTDLP_COOKIES_FILE=
# Navegadores (Windows): o bot escolhe sozinho, validando de verdade com o
# yt-dlp qual navegador entrega cookies utilizáveis naquele momento. Navegadores
# abertos têm prioridade. Brave, Edge, Zen, Chrome, Firefox, Chromium, Vivaldi
# e Opera são suportados (Zen usa o motor do Firefox por baixo).
# Ordem de preferência (opcional):
YTDLP_BROWSER_ORDER=brave,edge,zen,chrome,firefox
# Forçar um navegador específico (opcional; vazio = automático):
YTDLP_COOKIES_FROM_BROWSER=
# Validade do snapshot de cookies em ms (padrão: 6 horas):
YTDLP_COOKIES_VALIDADE_MS=
# Tempo entre sondagens de cookies e número máximo de navegadores testados.
YTDLP_COOKIES_TTL_MS=
YTDLP_COOKIES_MAX_TENTATIVAS=
# Runtime de JS para o YouTube resolver assinaturas (padrão: node):
YTDLP_JS_RUNTIME=
# Componentes remotos do yt-dlp (padrão: ejs:github):
YTDLP_REMOTE_COMPONENTS=
# Normalmente não é necessário alterar diretório ou nome do executável:
YTDLP_DIR=
YTDLP_FILENAME=
# URL alternativa para baixar o yt-dlp (avançado):
YTDLP_URL=

# ── Sons da Mila na call (opcionais) ─────────────────────────────────────────
# ── Som de espera ("elevator waiting") ───────────────────────────────────────
# Toca enquanto a música é resolvida e sai em fade out quando ela começa.
SOM_ESPERA_ATIVO=true
# Origem do MP3 (baixado uma vez para data/sons/espera-elevador.mp3)
SOM_ESPERA_URL=https://www.myinstants.com/media/sounds/elevator_2jN6tnc.mp3
# Alternativa: usar um arquivo local em vez de baixar
SOM_ESPERA_ARQUIVO=
SOM_ESPERA_VOLUME=0.3
SOM_ESPERA_FADE_IN_MS=900
SOM_ESPERA_FADE_OUT_MS=800
# Rede de segurança para o elevador não tocar para sempre (ms)
SOM_ESPERA_MAX_MS=120000

# ── Saudação de entrada e despedida ─────────────────────────────────────────
# Saudação aleatória ("um chapéu" / "saudações boininha") sempre que a Mila
# entra na call. Os MP3 são baixados uma vez para data/sons/.
SOM_ENTRADA_ATIVO=true
SOM_ENTRADA_VOLUME=0.5
SOM_ENTRADA_FADE_IN_MS=250
# Tempo máximo que a música espera a saudação terminar (ms)
SOM_ENTRADA_MAX_MS=6000
# "me deixa dormir mita" antes de sair de fato no /sair
SOM_DESPEDIDA_ATIVO=true
SOM_DESPEDIDA_VOLUME=0.55
# Alternativa: usar um arquivo local em vez do despedida-mita.mp3
SOM_DESPEDIDA_ARQUIVO=
SOM_DESPEDIDA_MAX_MS=20000

# ── Cache de áudio ──────────────────────────────────────────────────────────
# O yt-dlp baixa o áudio e o bot serve por HTTP local: evita o 403 que o CDN do
# YouTube devolve ao ffmpeg do DisTube (FFMPEG_EXITED).
AUDIO_CACHE_ATIVO=true
AUDIO_CACHE_DIR=
AUDIO_CACHE_HORAS=12
AUDIO_CACHE_MB=1024
AUDIO_CACHE_CONCORRENCIA=2
AUDIO_CACHE_TIMEOUT_MS=300000

# ── Site da Mila (Economia + temas) ─────────────────────────────────────────
# Sobe um site estático + API JSON no mesmo processo do bot.
# Acesse http://localhost:3000 (ou o host/porta que definir).
#
# Endereço público do site: aparece no perfil do bot e nos comandos.
# Para uso local, deixe localhost. Ao publicar, use seu domínio HTTPS real.
MILA_SITE_URL=http://localhost:3000
# O site sobe junto com o bot. Defina false para desligar.
WEB_ATIVO=true
WEB_PORT=3000
WEB_HOST=127.0.0.1
# URL pública usada em links (opcional; ex.: https://mila.exemplo.com)
WEB_PUBLIC_URL=
