# ⋆｡°✩ Mila Bot — Configuração
# Copy to .env and fill with your Discord Developer Portal values.
# NEVER commit your real .env file — it contains secrets.

# Discord bot token (keep this secret! rotate if leaked)
DISCORD_TOKEN=your-discord-token-here

# Application (bot) client ID — from discord.com/developers/applications
CLIENT_ID=your-client-id-here

# Servidor (guild) ID the bot is tested in
GUILD_ID=your-guild-id-here

# Toggle privileged intents (GuildMembers, GuildPresences).
# Keep false unless your bot actually needs member/presence data.
ENABLE_PRIVILEGED_INTENTS=false

# Personalização (optional — uses defaults if empty)
BOT_NOME=⋆｡°✩ Mila Bot
COMANDO_SOBRE_NOME=sobre
COMANDO_SOBRE_ALIAS=mila,milabot,botinfo
CONTEXTO_SERVIDOR=Mila Cake

# OAuth2 (only needed if your bot exposes web OAuth flows)
ALT_DISCORD_CLIENT_ID=
ALT_DISCORD_CLIENT_SECRET=

# Spotify Web API (Client Credentials, necessário para priorizar faixas do Spotify)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=BR
SPOTIFY_AUTH_PORT=8888
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# AI tooling configuration (keep local; do not commit provider keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
IMPECCABLE_API_KEY=

# Opcional: cookies exportados do navegador para reduzir bloqueios do YouTube
YTDLP_COOKIES_FILE=
# Opcional: chrome, firefox, brave, edge, chromium, vivaldi ou opera
# Se vazio, detecta automaticamente perfis com cookies e navegador fechado.
YTDLP_COOKIES_FROM_BROWSER=
